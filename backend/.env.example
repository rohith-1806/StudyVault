# StudyVault Backend Environment Variables

# Supabase Credentials (Optional for local execution, required for production)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Secret key for JWT signing
SECRET_KEY=studyvault-super-secret-key-change-in-production

# System Admin Credentials
ADMIN_EMAIL=admin@studyvault.edu
# Default password: "AdminPassword123!"
ADMIN_PASSWORD_HASH=scrypt:32768:8:1$xH2g8l9B4v2k0L5m$95096b79753065a78248bc3bebb0ef3878b273b4b0e50efb0ef7645bfbc094208a0d0d82dd2604ca75a5cb33a6f1947b19818b76db01b1df40003b573510e140

# Upload Configuration
MAX_UPLOAD_SIZE=26214400
AUTO_APPROVE=true
REWARD_DURATION_HOURS=24
STORAGE_BUCKET=documents

# Brevo (Sendinblue) Transactional Email Configuration
BREVO_API_KEY=replace_with_your_new_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_sender_email
BREVO_SENDER_NAME=StudyVault
FRONTEND_URL=http://localhost:5173

# Background Reminder Worker / Scheduler Settings
ENABLE_IN_APP_SCHEDULER=true
REMINDER_CHECK_INTERVAL_SECONDS=60

# AI Smart Summarization Configuration (Server-side only; never commit real keys)
# Supported providers: gemini (default), openai
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL=gemini-1.5-flash
# Optional: Set AI_MOCK=true for offline testing or deterministic CI runs
AI_MOCK=false
